#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_FILE="${SUI_MANAGER_CONFIG:-/etc/s-ui-installer/config.env}"
[[ -r "$CONFIG_FILE" ]] || {
  printf 'S-UI installer state not found: %s\n' "$CONFIG_FILE" >&2
  exit 1
}
# shellcheck disable=SC1090
. "$CONFIG_FILE"

log() { printf '\n[+] %s\n' "$*"; }
warn() { printf '\n[!] %s\n' "$*" >&2; }
die() { printf '\n[x] %s\n' "$*" >&2; exit 1; }
timestamp() { date -u +%Y%m%dT%H%M%SZ; }
CERT_SEARCH_ROOT="${CERT_SEARCH_ROOT:-/root}"
CERT_IN_CONTAINER="${CERT_IN_CONTAINER:-/app/cert/$(basename "$CERT_DEST")}"
KEY_IN_CONTAINER="${KEY_IN_CONTAINER:-/app/cert/$(basename "$KEY_DEST")}"

[[ "$SUI_DIR" == /* && "$SUI_DIR" != "/" && "$SUI_DIR" != "/root" ]] ||
  die "Unsafe SUI_DIR in ${CONFIG_FILE}"
[[ "$BACKUP_ROOT" == /* && "$BACKUP_ROOT" != "/" ]] ||
  die "Unsafe BACKUP_ROOT in ${CONFIG_FILE}"

compose() {
  (cd "$SUI_DIR" && docker compose "$@")
}

certificate_public_key_hash() {
  local certificate="$1"
  openssl x509 -in "$certificate" -pubkey -noout 2>/dev/null |
    openssl pkey -pubin -outform pem 2>/dev/null |
    sha256sum | awk '{print $1}'
}

private_key_public_hash() {
  local private_key="$1"
  openssl pkey -in "$private_key" -pubout -outform pem 2>/dev/null |
    sha256sum | awk '{print $1}'
}

certificate_pair_is_valid() {
  local certificate="$1"
  local private_key="$2"
  local certificate_hash=""
  local private_key_hash=""

  [[ -f "$certificate" && -f "$private_key" ]] || return 1
  openssl x509 -in "$certificate" -noout >/dev/null 2>&1 || return 1
  openssl pkey -in "$private_key" -noout >/dev/null 2>&1 || return 1
  certificate_hash="$(certificate_public_key_hash "$certificate")"
  private_key_hash="$(private_key_public_hash "$private_key")"
  [[ -n "$certificate_hash" && "$certificate_hash" == "$private_key_hash" ]] ||
    return 1
  openssl x509 -in "$certificate" -noout -checkhost "$DOMAIN" 2>/dev/null |
    grep -q 'does match' || return 1
  openssl x509 -checkend 0 -noout -in "$certificate" >/dev/null 2>&1
}

validate_certificate_pair() {
  local certificate="$1"
  local private_key="$2"
  local certificate_hash=""
  local private_key_hash=""

  [[ -f "$certificate" ]] || die "Certificate file not found: ${certificate}"
  [[ -f "$private_key" ]] || die "Private key file not found: ${private_key}"
  openssl x509 -in "$certificate" -noout >/dev/null 2>&1 ||
    die "Invalid certificate PEM: ${certificate}"
  openssl pkey -in "$private_key" -noout >/dev/null 2>&1 ||
    die "Invalid private key PEM: ${private_key}"
  certificate_hash="$(certificate_public_key_hash "$certificate")"
  private_key_hash="$(private_key_public_hash "$private_key")"
  [[ -n "$certificate_hash" && "$certificate_hash" == "$private_key_hash" ]] ||
    die "Certificate and private key do not match"
  openssl x509 -in "$certificate" -noout -checkhost "$DOMAIN" 2>/dev/null |
    grep -q 'does match' ||
    die "Certificate does not match ${DOMAIN}"
  openssl x509 -checkend 0 -noout -in "$certificate" >/dev/null 2>&1 ||
    die "Certificate is expired"
  if ! openssl x509 -checkend 1209600 -noout -in "$certificate" >/dev/null 2>&1; then
    warn "Certificate expires within 14 days"
  fi
}

find_certificate_pair() {
  FOUND_CERT=""
  FOUND_KEY=""
  local certificate=""
  local private_key=""

  while IFS='|' read -r certificate private_key; do
    [[ -n "$certificate" ]] || continue
    if certificate_pair_is_valid "$certificate" "$private_key"; then
      FOUND_CERT="$certificate"
      FOUND_KEY="$private_key"
      return 0
    fi
  done <<EOF
/etc/letsencrypt/live/${DOMAIN}/fullchain.pem|/etc/letsencrypt/live/${DOMAIN}/privkey.pem
${CERT_SEARCH_ROOT}/.acme.sh/${DOMAIN}_ecc/fullchain.cer|${CERT_SEARCH_ROOT}/.acme.sh/${DOMAIN}_ecc/${DOMAIN}.key
${CERT_SEARCH_ROOT}/.acme.sh/${DOMAIN}/fullchain.cer|${CERT_SEARCH_ROOT}/.acme.sh/${DOMAIN}/${DOMAIN}.key
${CERT_SEARCH_ROOT}/${DOMAIN}.pem|${CERT_SEARCH_ROOT}/${DOMAIN}.key
${CERT_SEARCH_ROOT}/fullchain.pem|${CERT_SEARCH_ROOT}/privkey.pem
EOF

  for certificate in \
    "${CERT_SEARCH_ROOT}"/*.pem \
    "${CERT_SEARCH_ROOT}"/*.crt \
    "${CERT_SEARCH_ROOT}"/*.cer; do
    [[ -f "$certificate" ]] || continue
    for private_key in \
      "${certificate%.*}.key" \
      "${CERT_SEARCH_ROOT}"/privkey.pem \
      "${CERT_SEARCH_ROOT}"/*.key \
      "${CERT_SEARCH_ROOT}"/*key*.pem; do
      [[ -f "$private_key" ]] || continue
      if certificate_pair_is_valid "$certificate" "$private_key"; then
        FOUND_CERT="$certificate"
        FOUND_KEY="$private_key"
        return 0
      fi
    done
  done
  return 1
}

update_certificate_source_config() {
  local certificate="$1"
  local private_key="$2"
  local temp=""
  temp="$(mktemp)"
  awk '!/^(CERT_SOURCE|KEY_SOURCE)=/' "$CONFIG_FILE" >"$temp"
  {
    printf 'CERT_SOURCE=%q\n' "$certificate"
    printf 'KEY_SOURCE=%q\n' "$private_key"
  } >>"$temp"
  install -m 0600 "$temp" "$CONFIG_FILE"
  rm -f "$temp"
  CERT_SOURCE="$certificate"
  KEY_SOURCE="$private_key"
}

backup_current_certificate() {
  local target=""
  target="${BACKUP_ROOT}/certificates/$(timestamp)"
  install -m 0700 -d "$target"
  [[ -f "$CERT_DEST" ]] &&
    cp -a "$CERT_DEST" "${target}/certificate.pem"
  [[ -f "$KEY_DEST" ]] &&
    cp -a "$KEY_DEST" "${target}/private.key"
  printf '%s' "$target"
}

wait_for_loaded_certificate() {
  local expected_fingerprint="$1"
  local loaded_certificate=""
  local loaded_fingerprint=""
  local _attempt=0

  for _attempt in $(seq 1 20); do
    loaded_certificate="$(timeout 5 openssl s_client \
      -connect "127.0.0.1:${WEB_PORT}" \
      -servername "$DOMAIN" </dev/null 2>/dev/null |
      openssl x509 -outform PEM 2>/dev/null || true)"
    if [[ -n "$loaded_certificate" ]]; then
      loaded_fingerprint="$(printf '%s' "$loaded_certificate" |
        openssl x509 -noout -fingerprint -sha256 2>/dev/null |
        cut -d= -f2)"
      [[ "$loaded_fingerprint" == "$expected_fingerprint" ]] && return 0
    fi
    sleep 1
  done
  return 1
}

apply_certificate_pair() {
  local certificate="$1"
  local private_key="$2"
  local update_source="${3:-0}"
  local changed=0
  local backup_dir=""
  local expected_fingerprint=""

  validate_certificate_pair "$certificate" "$private_key"
  cmp -s "$certificate" "$CERT_DEST" || changed=1
  cmp -s "$private_key" "$KEY_DEST" || changed=1

  if (( changed == 0 )); then
    if [[ "$update_source" == "1" ]]; then
      update_certificate_source_config "$certificate" "$private_key"
    fi
    printf 'Certificate content is already installed.\n'
    printf 'Source:      %s\n' "$certificate"
    printf 'Private key: %s\n' "$private_key"
    return 0
  fi

  backup_dir="$(backup_current_certificate)"
  install -m 0644 "$certificate" "${CERT_DEST}.new"
  install -m 0600 "$private_key" "${KEY_DEST}.new"
  mv -f "${CERT_DEST}.new" "$CERT_DEST"
  mv -f "${KEY_DEST}.new" "$KEY_DEST"
  expected_fingerprint="$(openssl x509 -in "$CERT_DEST" \
    -noout -fingerprint -sha256 | cut -d= -f2)"

  if compose restart s-ui &&
     wait_for_loaded_certificate "$expected_fingerprint"; then
    if [[ "$update_source" == "1" ]]; then
      update_certificate_source_config "$certificate" "$private_key"
    fi
    log "Certificate updated, loaded, and verified"
    printf 'Source: %s\n' "$certificate"
    printf 'Backup: %s\n' "$backup_dir"
    return 0
  fi

  warn "New certificate was not loaded; restoring previous certificate"
  [[ -f "${backup_dir}/certificate.pem" ]] &&
    install -m 0644 "${backup_dir}/certificate.pem" "$CERT_DEST"
  [[ -f "${backup_dir}/private.key" ]] &&
    install -m 0600 "${backup_dir}/private.key" "$KEY_DEST"
  compose restart s-ui || true
  die "Certificate update failed and was rolled back"
}

cert_status_cmd() {
  local host_cert_status="MISSING"
  local host_key_status="MISSING"
  local container_cert_status="unavailable"
  local container_key_status="unavailable"

  [[ -r "$CERT_DEST" ]] && host_cert_status="readable"
  [[ -r "$KEY_DEST" ]] && host_key_status="readable"

  if docker inspect s-ui --format '{{.State.Running}}' 2>/dev/null |
     grep -q true; then
    if docker exec s-ui test -r "$CERT_IN_CONTAINER" >/dev/null 2>&1; then
      container_cert_status="readable"
    else
      container_cert_status="MISSING"
    fi
    if docker exec s-ui test -r "$KEY_IN_CONTAINER" >/dev/null 2>&1; then
      container_key_status="readable"
    else
      container_key_status="MISSING"
    fi
  elif docker inspect s-ui >/dev/null 2>&1; then
    container_cert_status="container-stopped"
    container_key_status="container-stopped"
  fi

  printf 'Domain:             %s\n' "$DOMAIN"
  printf 'Configured source:  %s\n' "$CERT_SOURCE"
  printf 'Configured key:     %s\n' "$KEY_SOURCE"
  printf 'Installed cert:     %s (%s)\n' "$CERT_DEST" "$host_cert_status"
  printf 'Installed key:      %s (%s)\n' "$KEY_DEST" "$host_key_status"
  printf 'Container cert:     %s (%s)\n' \
    "$CERT_IN_CONTAINER" "$container_cert_status"
  printf 'Container key:      %s (%s)\n' \
    "$KEY_IN_CONTAINER" "$container_key_status"
  printf 'Auto-search root:   %s\n' "$CERT_SEARCH_ROOT"
  printf '\nInstalled certificate:\n'
  openssl x509 -in "$CERT_DEST" -noout \
    -subject -issuer -dates -fingerprint -sha256 \
    -ext subjectAltName 2>/dev/null ||
    warn "Installed certificate is unavailable or invalid"
  printf '\nUpdate commands:\n'
  printf '  s-ui-manager cert-auto\n'
  printf '  s-ui-manager cert-set /path/fullchain.pem /path/private.key\n'
  printf '  s-ui-manager cert-sync\n'
}

cert_auto_cmd() {
  log "Searching for a valid certificate matching ${DOMAIN}"
  find_certificate_pair ||
    die "No valid matching certificate pair found in Certbot, acme.sh, or ${CERT_SEARCH_ROOT}"
  printf 'Found certificate: %s\n' "$FOUND_CERT"
  printf 'Found private key: %s\n' "$FOUND_KEY"
  apply_certificate_pair "$FOUND_CERT" "$FOUND_KEY" 1
}

cert_set_cmd() {
  local certificate="${1:-}"
  local private_key="${2:-}"
  [[ -n "$certificate" && -n "$private_key" ]] ||
    die "Usage: s-ui-manager cert-set CERTIFICATE PRIVATE_KEY"
  apply_certificate_pair "$certificate" "$private_key" 1
}

status_cmd() {
  compose ps
  printf '\nPublished ports:\n'
  docker port s-ui 2>/dev/null | sort || true
  printf '\nCertificate:\n'
  openssl x509 -in "$CERT_DEST" -noout -subject -issuer -dates \
    -ext subjectAltName 2>/dev/null || true
  printf '\nSystem:\n'
  sysctl net.ipv4.tcp_congestion_control \
    net.core.default_qdisc net.ipv4.ip_forward 2>/dev/null || true
}

doctor_cmd() {
  local failures=0
  log "Container"
  if docker inspect s-ui --format '{{.State.Running}}' 2>/dev/null | grep -q true; then
    printf 'PASS: s-ui is running\n'
  else
    printf 'FAIL: s-ui is not running\n'
    failures=$((failures + 1))
  fi

  log "Ports"
  local expected=""
  for expected in "${WEB_PORT}/tcp" "${SUB_PORT}/tcp" "443/tcp" "443/udp" "8443/tcp"; do
    if docker port s-ui 2>/dev/null | grep -q "^${expected}"; then
      printf 'PASS: %s\n' "$expected"
    else
      printf 'FAIL: %s\n' "$expected"
      failures=$((failures + 1))
    fi
  done

  log "Certificate"
  if openssl x509 -in "$CERT_DEST" -noout -checkhost "$DOMAIN" 2>/dev/null |
     grep -q 'does match'; then
    printf 'PASS: certificate matches %s\n' "$DOMAIN"
  else
    printf 'WARN: certificate does not match %s (possibly self-signed example)\n' "$DOMAIN"
  fi
  if openssl x509 -checkend 1209600 -noout -in "$CERT_DEST" >/dev/null 2>&1; then
    printf 'PASS: certificate valid for more than 14 days\n'
  else
    printf 'FAIL: certificate expires within 14 days\n'
    failures=$((failures + 1))
  fi

  log "Panel HTTPS"
  local code=""
  code="$(curl -ksS -o /dev/null -w '%{http_code}' \
    --resolve "${DOMAIN}:${WEB_PORT}:127.0.0.1" \
    --connect-timeout 5 --max-time 12 \
    "https://${DOMAIN}:${WEB_PORT}${WEB_PATH}" 2>/dev/null || true)"
  case "$code" in
    200|301|302|303|307|308) printf 'PASS: HTTP %s\n' "$code" ;;
    *)
      printf 'FAIL: HTTP %s\n' "${code:-000}"
      failures=$((failures + 1))
      ;;
  esac

  (( failures == 0 )) || die "Doctor found ${failures} failure(s)"
  log "All required checks passed"
}

backup_cmd() {
  local target=""
  target="${BACKUP_ROOT}/$(timestamp)"
  install -m 0700 -d "$target"
  sqlite3 "${SUI_DIR}/db/s-ui.db" ".backup '${target}/s-ui.db'"
  chmod 0600 "${target}/s-ui.db"
  cp -a "${SUI_DIR}/docker-compose.yml" "${SUI_DIR}/.env" "$target/"
  cp -a "${SUI_DIR}/cert" "$target/"
  printf '%s\n' "$target" >"${BACKUP_ROOT}/latest"
  printf '%s\n' "$target"
}

restore_cmd() {
  local source="${1:-}"
  [[ -d "$source" ]] || die "Backup directory not found: ${source}"
  [[ -f "${source}/s-ui.db" ]] || die "Backup has no s-ui.db"
  local safety=""
  safety="$(backup_cmd)"
  log "Safety backup: ${safety}"
  compose stop s-ui
  install -m 0600 "${source}/s-ui.db" "${SUI_DIR}/db/s-ui.db"
  [[ -d "${source}/cert" ]] && {
    local old_cert_dir=""
    old_cert_dir="${SUI_DIR}/cert.before-restore.$(timestamp)"
    [[ -d "${SUI_DIR}/cert" ]] &&
      mv "${SUI_DIR}/cert" "$old_cert_dir"
    cp -a "${source}/cert" "${SUI_DIR}/cert"
  }
  compose up -d
}

cert_sync_cmd() {
  if [[ $# -eq 2 ]]; then
    cert_set_cmd "$1" "$2"
    return 0
  fi
  [[ $# -eq 0 ]] ||
    die "Usage: s-ui-manager cert-sync [CERTIFICATE PRIVATE_KEY]"
  [[ -f "$CERT_SOURCE" && -f "$KEY_SOURCE" ]] || {
    warn "Configured certificate source is unavailable"
    printf 'Configured source: %s\n' "$CERT_SOURCE"
    printf 'Configured key:    %s\n' "$KEY_SOURCE"
    printf 'Run: s-ui-manager cert-auto\n'
    return 1
  }
  apply_certificate_pair "$CERT_SOURCE" "$KEY_SOURCE" 0
}

update_cmd() {
  local release_json=""
  local latest=""
  release_json="$(curl -4 -fsSL --connect-timeout 5 --max-time 15 \
    https://api.github.com/repos/alireza0/s-ui/releases/latest 2>/dev/null || true)"
  latest="$(printf '%s' "$release_json" | jq -r '.tag_name // empty' 2>/dev/null || true)"
  [[ "$latest" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    die "Unable to resolve latest official S-UI release"

  local image="alireza7/s-ui:${latest}"
  if ! docker pull "$image"; then
    [[ "$DETECTED_REGION" == "china" ]] ||
      die "Unable to pull ${image}"
    image="docker.m.daocloud.io/alireza7/s-ui:${latest}"
    docker pull "$image"
  fi

  backup_cmd >/dev/null
  local old_env=""
  old_env="$(mktemp)"
  cp -a "${SUI_DIR}/.env" "$old_env"
  local temp=""
  temp="$(mktemp)"
  awk -v image="$image" '
    /^SUI_IMAGE=/ { print "SUI_IMAGE=" image; found=1; next }
    { print }
    END { if (!found) print "SUI_IMAGE=" image }
  ' "${SUI_DIR}/.env" >"$temp"
  install -m 0600 "$temp" "${SUI_DIR}/.env"
  rm -f "$temp"
  if ! compose up -d; then
    install -m 0600 "$old_env" "${SUI_DIR}/.env"
    rm -f "$old_env"
    compose up -d || true
    die "Update failed; previous image configuration restored"
  fi

  local _attempt=0
  for _attempt in $(seq 1 30); do
    if docker inspect s-ui --format '{{.State.Running}}' 2>/dev/null |
       grep -q true; then
      rm -f "$old_env"
      printf 'Updated S-UI to %s\n' "$latest"
      return 0
    fi
    sleep 1
  done

  install -m 0600 "$old_env" "${SUI_DIR}/.env"
  rm -f "$old_env"
  compose up -d || true
  die "Updated container did not become healthy; previous image restored"
}

usage() {
  cat <<'EOF'
Usage: s-ui-manager COMMAND

Commands:
  status                 Show container, ports, certificate, and sysctl
  doctor                 Run required health checks
  logs [N]               Show recent logs (default: 150 lines)
  update                 Backup and update to latest official S-UI
  backup                 Create an online SQLite/config/certificate backup
  restore DIR            Restore a backup after creating a safety backup
  cert-status            Show certificate source, destination, and validity
  cert-auto              Find a matching certificate and make it the new source
  cert-set CERT KEY      Validate and install an explicit certificate pair
  cert-sync [CERT KEY]   Sync the configured source, or set an explicit pair
  restart|start|stop     Control the S-UI container
  uninstall              Stop S-UI but preserve all data and backups
EOF
}

case "${1:-}" in
  status) status_cmd ;;
  doctor) doctor_cmd ;;
  logs) compose logs --tail="${2:-150}" s-ui ;;
  update) update_cmd ;;
  backup) backup_cmd ;;
  restore) restore_cmd "${2:-}" ;;
  cert-status) cert_status_cmd ;;
  cert-auto) cert_auto_cmd ;;
  cert-set) shift; cert_set_cmd "$@" ;;
  cert-sync) shift; cert_sync_cmd "$@" ;;
  restart) compose restart s-ui ;;
  start) compose up -d ;;
  stop) compose stop s-ui ;;
  uninstall)
    compose down
    systemctl disable --now s-ui-cert-sync.timer 2>/dev/null || true
    printf 'S-UI stopped. Data preserved in %s\n' "$SUI_DIR"
    ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 2 ;;
esac
