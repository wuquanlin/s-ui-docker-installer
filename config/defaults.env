# Stable fallback used only when the official latest-release API is unreachable.
SUI_FALLBACK_VERSION=v1.5.4

# Default deployment settings.
SUI_DIR=/opt/s-ui
BACKUP_ROOT=/var/backups/s-ui-installer
TIME_LOCATION=Asia/Shanghai
WEB_PORT=2095
SUB_PORT=2096
WEB_PATH=/app/
SUB_PATH=/sub/
REGION_MODE=auto
CERT_MODE=auto
OPEN_FIREWALL=1
ENABLE_IPV6_FORWARD=0
