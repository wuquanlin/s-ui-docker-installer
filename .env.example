DOMAIN=panel.example.com
CERT_SRC=/etc/letsencrypt/live/panel.example.com/fullchain.pem
KEY_SRC=/etc/letsencrypt/live/panel.example.com/privkey.pem
SUI_VERSION=latest
REGION_MODE=auto
ADMIN_USER=admin
TIME_LOCATION=Asia/Shanghai

# Optional cloud-specific Docker Hub accelerator.
# DOCKER_REGISTRY_MIRROR=https://your-account.mirror.aliyuncs.com

# Set only when a brief Docker daemon restart is acceptable.
# ALLOW_DOCKER_RESTART=1
